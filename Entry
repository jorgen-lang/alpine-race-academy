    <script>
        // Beräkna totalt pris och valt antal läger
        function calculateTotal() {
            const checkboxes = document.querySelectorAll('input[name="camps"]:checked');
            let total = 0;
            checkboxes.forEach(cb => {
                total += parseInt(cb.getAttribute('data-price') || 0);
            });

            document.getElementById('selectedCount').textContent = checkboxes.length;
            document.getElementById('totalPrice').textContent = total.toLocaleString('sv-SE') + ' kr';

            // Dölj felmeddelande om läger valts
            if (checkboxes.length > 0) {
                document.getElementById('errorAlert').classList.add('hidden');
            }
        }

        // Hantera formulärinlämning
        function handleFormSubmit(event) {
            event.preventDefault();

            const selectedCamps = document.querySelectorAll('input[name="camps"]:checked');
            const errorAlert = document.getElementById('errorAlert');

            // Validera att minst ett läger valts
            if (selectedCamps.length === 0) {
                errorAlert.classList.remove('hidden');
                errorAlert.scrollIntoView({ behavior: 'smooth', block: 'center' });
                return;
            }

            // Hämta värden från formuläret
            const name = document.getElementById('fullName').value;
            const age = document.getElementById('age').value;
            const club = document.getElementById('club').value;
            const email = document.getElementById('email').value;

            // Bygg sammanställning för modalen
            document.getElementById('modalName').textContent = name;
            document.getElementById('modalClubAge').textContent = `${club} (${age})`;

            const modalList = document.getElementById('modalCampsList');
            modalList.innerHTML = '';
            let total = 0;

            selectedCamps.forEach(cb => {
                const li = document.createElement('li');
                const price = parseInt(cb.getAttribute('data-price'));
                const date = cb.getAttribute('data-date');
                total += price;
                li.innerHTML = `<span class="font-medium">${cb.value}</span> <span class="text-xs text-slate-400">(${date})</span>`;
                modalList.appendChild(li);
            });

            document.getElementById('modalTotal').textContent = total.toLocaleString('sv-SE') + ' kr';
            document.getElementById('modalRef').textContent = '#ARA-' + Math.floor(1000 + Math.random() * 9000);

            // Visa modal
            const modal = document.getElementById('confirmationModal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeModal() {
            const modal = document.getElementById('confirmationModal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');

            // Återställ formuläret
            document.getElementById('registrationForm').reset();
            calculateTotal();
        }

        function shareOnSocial(platform) {
            const url = encodeURIComponent(window.location.href);
            const text = encodeURIComponent('Anmäl dig till Alpine Race Academys träningsläger!');
            if (platform === 'facebook') {
                window.open(`https://www.facebook.com/sharer/sharer.php?u=${url}`, '_blank');
            } else if (platform === 'instagram') {
                copyFormLink();
            }
        }

        function copyFormLink() {
            const textToCopy = window.location.href;
            const dummy = document.createElement('input');
            document.body.appendChild(dummy);
            dummy.value = textToCopy;
            dummy.select();
            document.execCommand('copy');
            document.body.removeChild(dummy);

            // Enkel feedback
            const btn = event.currentTarget;
            const originalIcon = btn.innerHTML;
            btn.innerHTML = '<i class="fa-solid fa-check"></i>';
            setTimeout(() => {
                btn.innerHTML = originalIcon;
            }, 2000);
        }
    </script>
